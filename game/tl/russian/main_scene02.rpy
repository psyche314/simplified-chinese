translate russian Scene_Cane_Sebas_Tavern_Night_65bb7540:


    c "Но ты знаешь... что я имел в виду... я обязательно позабочусь о нём... не волнуйся, парень..."


translate russian Scene_Cane_Sebas_Tavern_Night_72215971:


