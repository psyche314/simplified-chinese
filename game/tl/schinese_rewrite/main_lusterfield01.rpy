translate schinese_rewrite Ole_Voting_Got_Gwyd_Answer_df7cdc60:

    # o "A... A musical harp?"
    o "一……一把竖琴？"

translate schinese_rewrite Ole_Voting_Got_Gwyd_Answer_449b7950:

    # e "Yeah, the one you play with finger, I guess. I'm not sure why he wanted that though, Gwyddyon was confused also."
