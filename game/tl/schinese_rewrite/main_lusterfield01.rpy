    s "啊……哈哈哈……[e]……2比20。"

translate schinese_rewrite Sebas_Drunk_Bet_Cane_0f216b2c:

    # "Sebas takes his pouch from his bag, clumsily counting coins in his hand."
    "塞巴斯从包里拿出钱袋，笨拙地数着手里的硬币。"

translate schinese_rewrite Sebas_Drunk_Bet_Cane_4ee7581c:

    # s "20..."
    s "20……"

translate schinese_rewrite Sebas_Drunk_Bet_Cane_b8f541c6:

    # "You received 12 gold."
    "你收到了12枚金币。"

translate schinese_rewrite Sebas_Drunk_Bet_Cane_5e13ff23:

    # e "I think I should leave Sebas alone..."
    e "我想还是别打扰塞巴斯了……"

translate schinese_rewrite Sebas_Drunk_Bet_Cane_fb0b1bfb:

