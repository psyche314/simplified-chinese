translate schinese_rewrite Ole_Voting_Got_Gwyd_Answer_01db9bb8:

    # e "I suppose so."
    e "我想是吧。"

translate schinese_rewrite Ole_Voting_Got_Gwyd_Answer_ef21100d:

    # o "Alright then, give me a second to prepare the catalogue and some coins, we'll go when we're both ready, okay?"
