translate schinese_rewrite Ribba_Command_Controller_Speak_6fda34b2:

    # "His voice rings out clearly, warm and obedient."
    "他的声音清晰地响起，温和而顺从。"

translate schinese_rewrite Ribba_Command_Controller_Speak_cac85c80_1:

