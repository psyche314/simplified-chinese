translate schinese_rewrite Ribba_Command_Controller_Speak_5057cba0:

    # e "Now describe how it feels."
    e "现在描述一下你的感受。"

translate schinese_rewrite Ribba_Command_Controller_Speak_baebd1a3:

    # rb "It feels wickedly good... obeying you right here in front of everyone."
    rb "感觉好得邪乎……就在所有人面前这样服从你。"

translate schinese_rewrite Ribba_Command_Controller_Speak_81de5447:

    # rb "Go on then, assistant. Give me another order and let me make a proper show of it."
    rb "来吧，助手。再命令我一次，让我好好演给他们看。"

translate schinese_rewrite Ribba_Command_Controller_Speak_1f6fca0b:

    # "He speaks with genuine enthusiasm, tail swishing behind him."
    "他满怀热情地说着，身后的尾巴来回摆动。"

translate schinese_rewrite Ribba_Command_Controller_Speak_507e5c42:

    # "The controller finally eases its grip."
    "控制器终于稍稍松开了束缚。"

translate schinese_rewrite Ribba_Command_Controller_Speak_23fee8aa:

    # rb "You're really pushing it tonight... assistant."
    rb "你今晚真是越来越过分了……助手。"

translate schinese_rewrite Ribba_Command_Controller_Speak_900798a7:

    # "His voice still carries a hint of resentment."
    "他的声音中依然带着一丝怨意。"

translate schinese_rewrite Ribba_Command_Controller_Speak_d0f73963:

    # "His eyes meet yours for a long moment before he remembers the crowd and flashes them a wobbly grin."
    "他的目光与你相交了好一会儿，随后想起观众，朝他们挤出一个勉强的笑容。"

translate schinese_rewrite Ribba_Command_Controller_Speak_f22ebc70:

    # rb "Well? Did your magician do the trick nicely...?"
    rb "怎么？你的魔法师刚才的把戏演得不错吧……？"

translate schinese_rewrite Ribba_Command_Controller_Speak_c25ae568:

