translate schinese_rewrite Lothar_Night_Greet_98a4eced_1:

    # l "Good. Now, why not leave me and my guys in peace. We'll catch up later, [e]."
    l "很好。现在，能不能别来打扰我和我的伙计们？我们之后再聊，[e]。"

translate schinese_rewrite Lothar_Night_Greet_3cdf02a7_1:

    # e "Alright, see you."
    e "好，回头见。"

