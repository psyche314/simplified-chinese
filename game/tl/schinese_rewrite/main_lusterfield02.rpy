translate schinese_rewrite Lothar_Report_Dummy_6f8b99bc:

    l "是的,你可以走了,我等着..."

translate schinese_rewrite Lothar_Ask_Invasion_e9fc7cea:

    e "洛萨尔,你能再跟我说说你的计划吗?"

translate schinese_rewrite Lothar_Ask_Invasion_ec398aec:

