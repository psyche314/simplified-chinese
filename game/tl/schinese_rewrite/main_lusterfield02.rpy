translate schinese_rewrite Lothar_Correct_c31f797f:

    # l "Ha. Good, Good. I reckon your lizard friend had taught you well, really well."
    l "哈。很好，很好。我猜你的蜥蜴朋友把你教得不错，真的不错。"

