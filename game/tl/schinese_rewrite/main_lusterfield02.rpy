    l "……"

translate schinese_rewrite Lothar_Battle_Training_c18eb48e_1:

    # e "W-what?"
    e "什、什么？"

translate schinese_rewrite Lothar_Battle_Training_0def6bcb:

    # l "Yeah, I should give you some training..."
    l "是啊，我是该给你做些训练了……"

translate schinese_rewrite Lothar_Battle_Training_e98d4a0c:

    # l "I'll level up the dummy now. You should beat it quite easily if you're... capable."
    l "我现在就把人偶升个级。要是你……有本事的话，应该能轻松打败它。"

translate schinese_rewrite Lothar_Battle_Training_0bbe65d9:

