translate schinese_rewrite Dark_Forest1_Loop_ccfae3fd:

    # "The fire is still burning bright. Meat and random beer scattered around the area."
    "篝火依旧烧得很旺，周围散落着肉和各式各样的啤酒。"

translate schinese_rewrite Dark_Forest1_Loop_8bb08a26:

    # "Seems like you're stepping into the werewolves' turf."
    "看来你正踏入狼人的地盘。"

translate schinese_rewrite Dark_Forest1_Loop_3863d3b3:

    # "You notice a chest near the campsite, it seems to belong to the werewolves."
    "你注意到营地附近有个箱子，似乎属于狼人。"

translate schinese_rewrite Dark_Forest1_Loop_cf3dddf2:

    # "But you hear a werewolf... snoring near the chest..."
    "但你听到箱子旁传来一只狼人的……鼾声……"

translate schinese_rewrite Dark_Forest1_Loop_2dbfa9ea:

    # ww "Haaa... ARFFF... I- Bones...!"
    ww "哈啊……嗷呜……骨、骨头……！"

translate schinese_rewrite Dark_Forest1_Loop_3f11f411:

    # "It seems dangerous to get the chest content without waking the werewolf up."
    "不惊醒狼人就拿走箱中物品，似乎很危险。"

translate schinese_rewrite Dark_Forest1_Loop_f1a38a10:

    # "Unless you're stealthy enough... or you have a decent amount of {color=#d1e431}Agility{/color}."
    "除非你足够擅长潜行……或者拥有相当高的{color=#d1e431}敏捷{/color}。"

translate schinese_rewrite Dark_Forest1_Loop_9c9f352e:

    # "Plus, you're so close to the werewolf... you might be in danger if you get caught..."
    "而且你离狼人太近了……要是被发现，可能会有危险……"

translate schinese_rewrite Dark_Forest1_Loop_bc9b7189:

    # "You successfully opened the chest without the werewolf's notice."
    "你成功打开了箱子，没有惊动狼人。"

translate schinese_rewrite Dark_Forest1_Loop_7ef359b1:

    # "You found a Green Ointment, a Hunter Hat and 50 gold."
    "你找到了绿色药膏、猎人帽和50枚金币。"

translate schinese_rewrite Dark_Forest1_Loop_adc27b27:

    # "As you are trying to open the chest, the werewolf on your side becomes startled by your movement."
    "你正试图打开箱子时，身旁的狼人被你的动作惊动了。"

translate schinese_rewrite Dark_Forest1_Loop_59cb7a31:

    # "You poke the sleeping werewolf on his snout, he instantly jumps like getting electrocuted."
    "你戳了戳熟睡狼人的鼻尖，他立刻像触电似的跳了起来。"

translate schinese_rewrite Dark_Forest1_Loop_8f64f985:

    # ww "Uhm... bones... meat... prey... ahhh... so good. mhmmm..."
    ww "呃……骨头……肉……猎物……啊……真好。嗯嗯……"

translate schinese_rewrite Dark_Forest1_Loop_9f026f68:

    # ww "I want them all... aAWWOOOO...."
    ww "我全都要……嗷呜呜呜……"

translate schinese_rewrite Dark_Forest1_Loop_bb74cfdf:

    # "For a sleeptalker, this werewolf surely sleeps a lot... and talks a lot."
    "对一个说梦话的人来说，这个狼人还真是睡得多、说得也多……"

translate schinese_rewrite Dark_Forest1_Loop_c6ba894c:

    # "You follow the path back to the entrance."
    "你沿着小路回到入口。"

translate schinese_rewrite Dark_Forest1_Loop_01d68d04:

    # "You leave the forest through the dirt path."
    "你沿着泥土小路离开了森林。"

translate schinese_rewrite Dark_Forest1_Loop_df2a1d92:

    # "After a few minutes of walking, you discover a cave shaped as wolf in front of you."
    "走了几分钟后，你发现前方有个狼形洞穴。"

translate schinese_rewrite Dark_Forest1_Loop_40df3c2b:

    # "It must be the werewolf den..."
    "这一定是狼人的巢穴……"

translate schinese_rewrite Dark_Forest1_Loop_83b31964:

    # "You reach to the wooden door. It seems to be sealed from the other side."
    "你来到一扇木门前。门似乎从另一侧被封死了。"

translate schinese_rewrite Dark_Forest1_Loop_ecfae962:

    # "There's a symbol of wolf carved on the door, with the sign saying... 'no- enter. wolf inside'"
    "门上刻着狼的图案，旁边写着……“禁止进入。内有狼。”"

translate schinese_rewrite Dark_Forest1_Loop_8b416141:

    # "There must be some way for you to unlock the door."
    "一定有办法打开这扇门。"

translate schinese_rewrite Dark_Forest1_Loop_5ca83b3f:

    # "CLICK. You hear a crisp noise before the door is suddenly unlocked."
    "咔哒。你听到一声清脆的响声，门突然解锁了。"

translate schinese_rewrite Dark_Forest1_Sleeping_Wolf_7233edaf:

    # ww "Uhm... W-what?"
    ww "呃……什、什么？"

translate schinese_rewrite Dark_Forest1_Sleeping_Wolf_277473e6:

    # "The werewolf looks at you in confusion, still trying to figure out if this is his dream or not."
    "狼人困惑地看着你，仍在努力弄清这究竟是他的梦境还是现实。"

translate schinese_rewrite Dark_Forest1_Sleeping_Wolf_fe7a3313:

    # ww "W-what? I'm obviously awake... Do you think I'm that dumb..."
    ww "什、什么？我当然醒着……你以为我有那么蠢吗……"

translate schinese_rewrite Dark_Forest1_Sleeping_Wolf_c0c9f0b1:

    # ww "uhmm... a breakfast just in time...."
    ww "嗯……正好赶上的早餐……"

translate schinese_rewrite Dark_Forest1_Sleeping_Wolf_c193bc27:

    # ww "Come here... little prey."
    ww "过来……小猎物。"

translate schinese_rewrite Dark_Forest1_Werewolf_7b7a5e55:

    # "As you walk through the forest, you encountered a werewolf."
    "你在森林中行走时，遇到了一只狼人。"

translate schinese_rewrite Dark_Forest1_Werewolf_aa740c79:

    # "Immediately, you begin to run towards the opposite direction, but soon a dark figure comes into your view."
    "你立刻转身朝相反方向跑去，但很快，一个黑影出现在你的视野中。"

translate schinese_rewrite Dark_Forest1_Werewolf_f7dd4053:

    # e "Fuck..."
    e "妈的……"

translate schinese_rewrite Dark_Forest1_Mimic_1c02c8e5:

    # "You run into a chest in the forest, you walk towards it, trying to open the chest."
    "你在森林里撞见了一个箱子，便走上前去，试图打开它。"

translate schinese_rewrite Dark_Forest1_Mimic_e4a118d9:

    # "Suddenly the chest jumps right into your face, it's not a chest, it is a mimic."
    "箱子突然直扑你的脸，你这才发现它根本不是箱子，而是一只宝箱怪。"

translate schinese_rewrite Dark_Forest1_Mimic_384c5823:

    # "Mimic" "RAWAWWWR-"
    "嗷呜呜呜——" "RAWWWWWWWWWWW-"

translate schinese_rewrite Dark_Forest1_Mimic_68fd897f:

    # "You scream, its tongue is slithering out, trying to latch on you..."
    "你尖叫起来，它的舌头蜿蜒着伸出，试图缠住你……"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_905acc56:

    # "You exit the werewolves' den."
    "你离开了狼人的巢穴。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_3d7485e3:

    # ww2 "Ready to hunt, little prey? I can give you a private lesson. Only us two."
    ww2 "准备好狩猎了吗，小猎物？我可以单独给你上一课。就我们两个。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_ff1e3f4f:

    # e "Uh, no thanks..."
    e "呃，不用了……"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_ca8a2444:

    # "The werewolf is snoring loudly, much of what's expected from a werewolf in dark forest."
    "狼人鼾声如雷，这倒是符合黑暗森林里狼人的一贯表现。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_0ccc0518:

    # ww4 "Duh, duh, duh, duh... duh..."
    ww4 "嘟、嘟、嘟、嘟……嘟……"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_52698b70:

    # "He seems to be mumbling some tunes, but you don't recognise that."
    "他似乎在哼唱某种曲调，但你听不出那是什么。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_42d3cff0:

    # ww5 "See this, I call this un-clawing."
    ww5 "看这个，我把这招叫作“收爪拳”。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_5779d5ae:

    # "The werewolf says as he throws a fist towards you."
    "狼人说着，朝你挥出一拳。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_7a490476:

    # ww5 "I'm using my claws, but instead of opening my palm, I close it like this."
    ww5 "我用的是爪子，只不过不张开手掌，而是像这样握紧。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_862f1f5a:

    # e "Isn't that just punching?"
    e "那不就是出拳吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_a9a5c68a:

    # ww5 "No! I call this un-clawing, didn't you hear? I hide all these nails to increase my raw power."
    ww5 "不！我把这招叫作“收爪拳”，没听见吗？我把这些爪子全藏起来，以此提升纯粹的力量。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_85e3ee8c:

    # ww5 "It's good for when you want to knock someone out. Do you wanna try?"
    ww5 "想把人打晕时，这招很好用。你要不要试试？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_0ddd972d:

    # e "To punch?"
    e "拿来打拳？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_aa3379c4:

    # ww5 "No, I am the one un-clawing."
    ww5 "不，是我在使出收爪拳。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_c65146e8:

    # ww "Three pieces of meat, one piece of bone... 5 or 6 bottles of wine... and a book?"
    ww "三块肉，一根骨头……五六瓶酒……还有一本书？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_67e75883:

    # ww "Which son of a tool put a book in our inventory again, you can't eat all that pages."
    ww "哪个蠢货又把书放进我们的物品栏了？书页又不能吃。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_694cbcb6:

    # ww "Unless...?"
    ww "除非……？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_0a8673d7:

    # ww3 "You're not werewolf-shaped... you are not even wolf-shaped."
    ww3 "你长得不像狼人……甚至连狼都不像。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_13c9dfe2:

    # e "Uffe allowed me here."
    e "泰托允许我进来的。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_f96bd936:

    # ww3 "Alright, walking meat. I'll one-up the alpha and allow you in my stomach, wanna come in?"
    ww3 "行吧，行走的肉。我这就压阿尔法一头，让你进我的肚子里，想进来吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_6b70fcfd:

    # e "Uhmm..."
    e "呃……"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_bcc0cfd4:

    # tart "No take! Tres-Passers deserves no meat."
    tart "不拿！闯入者不配吃肉。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_4539288e:

    # tart "Alpha says, food is for Alpha."
    tart "阿尔法说，食物是阿尔法的。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_b35739cc:

    # tart "What you doing, tres-Passer?"
    tart "你在做什么，闯入者？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_3df6c54a:

    # e "Uh... I'm just looking around, who are you?"
    e "呃……我只是四处看看，你是谁？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_656dcedc:

    # tart "Is Tart."
    tart "是塔特。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_2e7a1469:

    # e "Oh, you mean the food?"
    e "哦，你是说食物？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_7ac52210:

    # tart "No, food doesn't like Tart. I am Tart."
    tart "不，食物不喜欢塔特。我就是塔特。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_ac078a88:

    # e "O-ok, that was confusing to say the least."
    e "哦、好吧……这说法真是让人困惑。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_3c04a8eb:

    # tart "You are watching out. Alpha says what, you do what."
    tart "你可要注意。阿尔法说什么，你就做什么。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_735938b3:

    # tart "Alpha saying, you keep silent."
    tart "阿尔法说安静，你就保持安静。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_a851c4e0:

    # tart "Saying no means death. No?"
    tart "说不就等于死。懂吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_10f12935:

    # "You're not entirely sure what he means, so you just nod."
    "你不太确定他是什么意思，只好点了点头。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_adae0872:

    # e "Uh, yes."
    e "呃，是的。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_218493f3:

    # e "Are you very close with Uffe?"
    e "你和泰托关系很亲近吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_fff05497:

    # tart "He's Alpha, Tart helps alpha. Very easy to under-Stand."
    tart "他是阿尔法，塔特当然要帮阿尔法。很容、容易理解。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_faaf10ad:

    # "Tart says as he scratches the ground with his nails."
    "塔特说着，用爪子抓挠着地面。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_65cd3976:

    # e "What do you do other than... defending the alpha?"
    e "除了……保护阿尔法，你还做什么？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_551a6ce1:

    # tart "Tart's purpose is to keep alpha safe."
    tart "塔特的职责就是保护阿尔法的安全。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_b8b2ef72:

    # "The grey werewolf scratches the fur on his chin, then continues staring at you."
    "灰色狼人挠了挠下巴上的毛，然后继续盯着你。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_3938219b:

    # tart "If you raise weapon, Tart will kill. Don't do that, no?"
    tart "如果你拔出武器，塔特就会杀了你。别这么做，明白吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_0ccf3691:

    # e "A-alright, you have my words."
    e "好、好的，我答应你。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_d3ce2f6b:

    # tart "Alpha is mad. No one solves the puzzle."
    tart "阿尔法很生气。没人能解开谜题。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_9d679405:

    # e "Uffe told me to go there as well, what's the puzzle like?"
    e "泰托也让我去那里，那个谜题是什么样的？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_f4e82445:

    # tart "Not seen. Tart sends one of us to stay. He stucks still. It takes too long."
    tart "没看见。塔特派我们中的一个去守着。他卡在那里不动。太久了。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_bbcd7f58:

    # tart "We need hunt, not think. Alpha is not understanding. But Tart... protects alpha."
    tart "我们要狩猎，不要思考。阿尔法不明白。但塔特……保护阿尔法。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_e8a0aa93:

    # tart "You need please alpha. Think. Think!"
    tart "你得让阿尔法满意。想想。想想！"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_9699ca4c:

    # tart "Were-Wolves escaped. Alpha is mad again. You blow whistle, easy."
    tart "狼人逃跑了。阿尔法又生气了。吹响口哨，很简单。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_9a1f141d:

    # e "Who are these werewolves that we needed to catch, Tart?"
    e "塔特，我们要抓的那些狼人是谁？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_4b94f020:

    # tart "Tart's frien-"
    tart "塔特的朋——"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_9a7c6f8e:

    # tart "Enemy! They are alpha's enemy."
    tart "敌人！他们是阿尔法的敌人。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_197f5f3e:

    # e "Friends? Have you talked with them before?"
    e "朋友？你以前和他们聊过吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_e410c704:

    # tart "Yes, but they changed."
    tart "聊过，但他们变了。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_9558395b:

    # tart "I never know when they leave. I... not under-Stand."
    tart "我从不知道他们什么时候离开。我……不、不明白。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_4304f433:

    # tart "Our pack is always good. Why they want to leave..."
    tart "我们的族群一直都很好。他们为什么想离开……"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_40037e54:

    # tart "It's end. Amulet is back for alpha."
    tart "结束了。护符回到阿尔法手里。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_34fc010b:

    # e "Can you let me know what's the use of that moonstone amulet?"
    e "你能告诉我那个月光石护符有什么用吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_b0b5ce3c:

    # tart "More power. You sacrifice something for more power."
    tart "获得更强的力量。你需要牺牲某样东西来换取更强的力量。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_d7190bfe:

    # tart "Alpha says he can use full potential of the amulet, but Tart does not under-Stand."
    tart "阿尔法说他能发挥护符的全部潜力，但塔特不明白。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_eaa7af4f:

    # tart "Soon we conquer out of dark forest, amulet is only first step."
    tart "很快我们就会征服黑暗森林以外的地方，护符只是第一步。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_7956263b:

    # tart "The brothers are back."
    tart "那对兄弟回来了。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_d4a52cdd:

    # e "W-wait, so where are they... did Uffe really killed them?"
    e "等、等等，那他们在哪里……难道泰托真的杀了他们？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_38ed7a29:

    # tart "No, no yet. They're locked away."
    tart "不，还没有。他们被关起来了。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_72a3960c:

    # tart "Alpha says there is some use to them, so Tart guards Tetto and Rumma."
    tart "阿尔法说他们还有用，所以塔特负责看守泰托和鲁玛。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_a4d5004e:

    # "The grey werewolf stares at you silently."
    "灰色狼人默默地盯着你。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_c8c98a6c:

    # "You hear a rumbling sound in the direction of the grey werewolf."
    "你听到灰色狼人那边传来一阵咕噜声。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_0259bd4a:

    # e "Uh, Tart, you need some food?"
    e "呃，塔特，你需要吃点东西吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_b9cb10cf:

    # tart "N-no. Tart is not to eat at this time."
    tart "不、不。现在还不是塔特吃东西的时候。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_194d9846:

    # "He turns his head away."
    "他把头转开。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_7a8a32a6:

    # tart "Hey, tres-Passer, Tart's hungry. Meat?"
    tart "嘿，闯入者，塔特饿了。肉？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_764762c7:

    # e "D-don't your pack have food?"
    e "你、你的族群没有食物吗？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_c1207026:

    # tart "Food's not for Tart, it's for alpha."
    tart "食物不是给塔特的，是给阿尔法的。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_6eff2123:

    # e "Uh... Can't you just ask Alpha? You're like his right-hand wolf after all."
    e "呃……你不能直接问阿尔法吗？毕竟你可是他的得力干将啊。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_d5f8a38a:

    # tart "Meat, give meat. Tart's tummy shouting."
    tart "肉，给塔特肉。塔特的肚子在叫。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_2f84492b:

    # e "Alright, how much do you want?"
    e "好吧，你想要多少？"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_951c9847:

    # tart "If tres-Passer has 5 meat, Tart gives toys." nointeract
    tart "闯入者有5块肉的话，塔特就给玩具。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_63c20ab3:

    # e "Alright, I'll get you the meat."
    e "好吧，我去给你拿肉。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_7eab199b:

    # e "Sorry, I don't have that many meat."
    e "抱歉，我没有那么多肉。"

translate schinese_rewrite Moonlit_Wolf_Den_Loop_d0ad19fe:

    # tart "Ok. Tart stays, hungry."
    tart "好。塔特会继续挨饿。"
