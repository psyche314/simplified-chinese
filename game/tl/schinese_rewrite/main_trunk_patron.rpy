translate schinese_rewrite Trunk_Drunk_Dialogue_45a75a99:

    # drunk_patron "I'm still waiting for my beer, server!"
    drunk_patron "我还在等我的啤酒呢，服务员！"

translate schinese_rewrite Trunk_Drunk_Dialogue_cd658f58:

    # e "There it is, enjoy."
    e "在这儿呢，请慢用。"

translate schinese_rewrite Trunk_Drunk_Dialogue_06bd3b64:

    # "You hand him the ale, watching as he takes a long gulp from the mug."
    "你把麦芽酒递给他，看着他从杯子里长长地喝了一口。"

translate schinese_rewrite Trunk_Drunk_Dialogue_255ace2f:

    # drunk_patron "Whatever... it's not beer, but it'll do... for now."
    drunk_patron "随便吧……不是啤酒，但现在也只能凑合了……"

translate schinese_rewrite Trunk_Drunk_Dialogue_b5f7ecfd:

    # "You hand him the beer, watching as he takes a long gulp from the mug."
    "你把啤酒递给他，看着他从杯子里长长地喝了一口。"

translate schinese_rewrite Trunk_Drunk_Dialogue_beba1e09:

    # drunk_patron "Ah... that's the stuff. Thanks, server. You're a good one, you are."
    drunk_patron "啊……就是这个味儿。谢谢你，服务员。你人真不错。"

translate schinese_rewrite Trunk_Drunk_Dialogue_76345c45:

    # e "You're welcome. Now, pay up, for the price of two beers."
    e "不客气。现在付钱吧，按两杯啤酒的价钱算。"

translate schinese_rewrite Trunk_Drunk_Dialogue_48f3d289:

    # drunk_patron "Pay up? But... bu-"
    drunk_patron "付钱？可是……可——"

translate schinese_rewrite Trunk_Drunk_Dialogue_1f441160:

    # "You cross your arms, waiting for him to finish his sentence."
    "你抱起双臂，等着他说完。"

translate schinese_rewrite Trunk_Drunk_Dialogue_e93981fe:

    # drunk_patron "Fine... fine... it's not like I'm broke... here you go, server."
    drunk_patron "好吧……好吧……又不是说我没钱……给你，服务员。"

translate schinese_rewrite Trunk_Drunk_Dialogue_3d8b11f1:

    # "He hands you 40 coins, his hand shaking slightly as he does so."
    "他递给你40枚硬币，手还微微发着抖。"

translate schinese_rewrite Trunk_Drunk_Dialogue_f6d77b4a:

    # e "Thank you. Enjoy your drink."
    e "谢谢。慢用。"

translate schinese_rewrite Trunk_Drunk_Dialogue_e9004034:

    # drunk_patron "Where's my beer? I've been waiting for ages!"
    drunk_patron "我的啤酒呢？我都等半天了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_a9f46e50:

    # e "Here you go."
    e "给你。"

translate schinese_rewrite Trunk_Drunk_Dialogue_06bd3b64_1:

    # "You hand him the ale, watching as he takes a long gulp from the mug."
    "你把麦芽酒递给他，看着他从杯子里长长地喝了一口。"

translate schinese_rewrite Trunk_Drunk_Dialogue_255ace2f_1:

    # drunk_patron "Whatever... it's not beer, but it'll do... for now."
    drunk_patron "随便吧……不是啤酒，但现在也只能凑合了……"

translate schinese_rewrite Trunk_Drunk_Dialogue_e4d3ca7a:

    # drunk_patron "Ah-... wait... this isn't beer!"
    drunk_patron "啊——等等……这不是啤酒！"

translate schinese_rewrite Trunk_Drunk_Dialogue_a19ada82:

    # drunk_patron "I asked for beer, not ale! I can't drink this!"
    drunk_patron "我要的是啤酒，不是麦芽酒！这东西我喝不下去！"

translate schinese_rewrite Trunk_Drunk_Dialogue_83be0818:

    # e "Beggars can't be choosers, you know."
    e "要饭的没得挑，你懂的。"

translate schinese_rewrite Trunk_Drunk_Dialogue_5b60b363:

    # drunk_patron "B-but... I... I can't drink this! I said I wanted beer!"
    drunk_patron "可、可是……我……我喝不下去！我说了我要啤酒！"

translate schinese_rewrite Trunk_Drunk_Dialogue_b243fae6:

    # e "Take it or leave it."
    e "爱喝就喝，不喝拉倒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_d8286d79:

    # drunk_patron "Fine... whatever..."
    drunk_patron "好吧……随便。"

translate schinese_rewrite Trunk_Drunk_Dialogue_94243f03:

    # "He takes the ale from you, grumbling under his breath."
    "他从你手里接过麦芽酒，低声嘟囔着。"

translate schinese_rewrite Trunk_Drunk_Dialogue_c445560c:

    # "You watch as he takes a sip, his face scrunching up in disgust as he swallows the bitter liquid."
    "你看着他喝了一口；咽下这苦涩的液体时，他厌恶地皱起了脸。"

translate schinese_rewrite Trunk_Drunk_Dialogue_fa2f7692:

    # drunk_patron "Ugh... what is this? It tastes like... like... uhh..."
    drunk_patron "呃……这是什么？尝起来……像……像……呃……"

translate schinese_rewrite Trunk_Drunk_Dialogue_6fcf0a86:

    # "Ostensibly, he raises his mug to his lips and chugs down the rest of the ale, grimacing as he does so."
    "他装模作样地把杯子举到唇边，一口气灌下剩余的麦芽酒，同时痛苦地皱着眉。"

translate schinese_rewrite Trunk_Drunk_Dialogue_3cc40849:

    # e "Yeah, here you go."
    e "是啊，给你。"

translate schinese_rewrite Trunk_Drunk_Dialogue_06f25aa0:

    # drunk_patron "Ah, finally! Beer... I thought you'd forgotten about me!"
    drunk_patron "啊，终于！啤酒……我还以为你把我忘了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_b5f7ecfd_1:

    # "You hand him the beer, watching as he takes a long gulp from the mug."
    "你把啤酒递给他，看着他从杯子里长长地喝了一口。"

translate schinese_rewrite Trunk_Drunk_Dialogue_dcef7b17:

    # "He looks at you, his eyes wide with panic as he fumbles in his pockets."
    "他看着你，惊慌地睁大双眼，同时手忙脚乱地摸索着口袋。"

translate schinese_rewrite Trunk_Drunk_Dialogue_74282b08:

    # drunk_patron "I... I don't have enough... I... I... hic... I'm broke!"
    drunk_patron "我……我钱不够……我……我……嗝……我没钱了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_3c610516:

    # e "Uh... Is this another one of your tricks?"
    e "呃……这是你的又一个把戏吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_25ea18d3:

    # drunk_patron "No! No... I swear! I... I... I don't have enough! Look!"
    drunk_patron "不！不是……我发誓！我……我……我钱不够！你看！"

translate schinese_rewrite Trunk_Drunk_Dialogue_47c45f3a:

    # "He shows you his empty pockets, his hands shaking as he does so."
    "他把空口袋翻给你看，双手也跟着发抖。"

translate schinese_rewrite Trunk_Drunk_Dialogue_43c5223f:

    # e "You'll have to pay... or I'll have to let Cane know about this. He won't be happy about this."
    e "你得付钱 否则我不得不让凯恩知道这件事 他不会高兴的。"

translate schinese_rewrite Trunk_Drunk_Dialogue_401d1cd2:

    # drunk_patron "No! No... don't tell the barkeep! I... I... I'll pay you back! I swear! I-"
    drunk_patron "不！不……别告诉酒保！我……我……我会还钱的！我发誓！我——"

translate schinese_rewrite Trunk_Drunk_Dialogue_8d92027c:

    # "His voice trails off as he looks around the tavern, before turning back to you with pleading eyes."
    "他的声音渐渐低了下去。他环顾酒馆一圈，又用哀求的目光转回来看你。"

translate schinese_rewrite Trunk_Drunk_Dialogue_aa7d1be1:

    # "You can see the realization dawning on his face as he pulls out something from his pocket."
    "你能看出他脸上渐渐浮现出恍然大悟的神情，同时他从口袋里掏出一样东西。"

translate schinese_rewrite Trunk_Drunk_Dialogue_329c5b74:

    # drunk_patron "Here... take it... it's my amulet... it's worth... worth more than the beer!"
    drunk_patron "给……拿去……这是我的护符……它……它比啤酒值钱多了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_31c4ee0c:

    # "He hands you the amulet with gold inlay, nodding at you as you squint at the tiny etchings."
    "他把一枚镶金护符递给你；你眯起眼看着上面细小的刻纹，他则朝你点了点头。"

translate schinese_rewrite Trunk_Drunk_Dialogue_1d44809a:

    # e "What's this?"
    e "这是什么？"

translate schinese_rewrite Trunk_Drunk_Dialogue_99ee8bed:

    # drunk_patron "It's... it's my old amulet... they said the storekeepers would give you discounts if you wear it..."
    drunk_patron "这……这是我的旧护符……他们说，戴着它的话，店主会给你打折……"

translate schinese_rewrite Trunk_Drunk_Dialogue_8ab2eb46:

    # e "This is worth more than the beer, you know."
    e "这东西比啤酒值钱，你知道的。"

translate schinese_rewrite Trunk_Drunk_Dialogue_6548c999:

    # drunk_patron "I... I... I don't need it anymore... just... hic... just take it, server."
    drunk_patron "我……我……我已经用不着它了……就……嗝……就拿去吧，服务员。"

translate schinese_rewrite Trunk_Drunk_Dialogue_3991843c:

    # "You take the amulet, nodding at him as you pocket the item."
    "你接过护符，朝他点点头，把它收进了口袋。"

translate schinese_rewrite Trunk_Drunk_Dialogue_65b4b818:

    # drunk_patron "Here it is... hic... here it is... the money... ready for you, server."
    drunk_patron "在这儿……嗝……在这儿……钱……给你的钱，服务员。"

translate schinese_rewrite Trunk_Drunk_Dialogue_abdbf535:

    # "He points on the table, feinting a drunken smile as he stare at you."
    "他指着桌面，朝你挤出一个醉醺醺的笑。"

translate schinese_rewrite Trunk_Drunk_Dialogue_ca30485d:

    # drunk_patron "Look... this is a boon for being a good friend with me."
    drunk_patron "看……这是给好朋友的好处。"

translate schinese_rewrite Trunk_Drunk_Dialogue_a445f750:

    # "You take the 25 coins, nodding at him as you pocket the money."
    "你拿走25枚硬币，朝他点点头，把钱收进了口袋。"

translate schinese_rewrite Trunk_Drunk_Dialogue_2ff138e0:

    # e "A boon for paying what you bought, you mean."
    e "你是说，付清自己买的东西算是好处？"

translate schinese_rewrite Trunk_Drunk_Dialogue_28ea868a:

    # drunk_patron "I'll take it as an approval."
    drunk_patron "我就当你是在夸我。"

translate schinese_rewrite Trunk_Drunk_Dialogue_cc4a541e:

    # e "You're welcome. Now, pay up."
    e "不客气。现在付钱吧。"

translate schinese_rewrite Trunk_Drunk_Dialogue_7ff27543:

    # "You crosses your arms, watching him as he finishes the ale."
    "你抱起双臂，看着他喝完麦芽酒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_d5b8b080:

    # drunk_patron "Pay up? That wasn't... hic... that wasn't beer! I can't pay for that!"
    drunk_patron "付钱？那不是……嗝……那不是啤酒！我才不付钱！"

translate schinese_rewrite Trunk_Drunk_Dialogue_3ed02c69:

    # e "You drank it, you liked it, so you pay for it."
    e "你喝了，也喜欢喝，所以就得付钱。"

translate schinese_rewrite Trunk_Drunk_Dialogue_640a904c:

    # drunk_patron "But... but... I didn't like it! It was... it was... hic... it was disgusting!"
    drunk_patron "可……可我不喜欢！那……那是……嗝……那是恶心透顶的东西！"

translate schinese_rewrite Trunk_Drunk_Dialogue_80f934e2:

    # "He looks at you with pleading eyes, the redness in his cheeks clearly betrays his fondness for the ale."
    "他用哀求的目光看着你，脸颊的红晕明明白白地暴露了他对麦芽酒的喜爱。"

translate schinese_rewrite Trunk_Drunk_Dialogue_32166bff:

    # drunk_patron "You're a good one, you are. I like you. You're... hic... you're my friend now."
    drunk_patron "你人真好。我喜欢你。你……嗝……你现在就是我的朋友了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_c5b3dfc5:

    # drunk_patron "And... as my friend... you should know... I'm... I'm... hic... I'm broke."
    drunk_patron "而且……作为我的朋友……你应该知道……我……我……嗝……我没钱了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_f48b8fe3:

    # "He looks at you with a sheepish grin."
    "他朝你露出一个腼腆的笑容。"

translate schinese_rewrite Trunk_Drunk_Dialogue_c43db269:

    # e "You promised to pay me last time, remember?"
    e "你上次答应过要还钱给我，还记得吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_9fcff2c8:

    # drunk_patron "I did? Oh... I did, didn't I?"
    drunk_patron "我答应过？哦……我答应过，对吧？"

translate schinese_rewrite Trunk_Drunk_Dialogue_9d52354b:

    # "You can see the realization dawning on his face as he tries to remember."
    "他努力回忆时，你能看出恍然大悟的神情正浮现在他脸上。"

translate schinese_rewrite Trunk_Drunk_Dialogue_01b79fe7:

    # drunk_patron "I'm... I'm sorry. I'll pay you back my friend, I swear! Just... just give me another beer, okay?"
    drunk_patron "我……我很抱歉。我会还钱给你的，朋友，我发誓！就……就再给我一杯啤酒，好吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_c9588e17:

    # "He looks at you with pleading eyes, the beer in his hand is already almost empty."
    "他用哀求的目光看着你，他手里的啤酒已经快见底了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_3037491f:

    # e "Fine, but you have to pay for both's price."
    e "好吧，但你得把两杯的钱都付了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_b64a82f6:

    # drunk_patron "I will... now give me the beer... server."
    drunk_patron "我会的……现在把啤酒给我……服务员。"

translate schinese_rewrite Trunk_Drunk_Dialogue_df3ce9ba:

    # "You shake your head as you pull back from the table."
    "你摇摇头，从桌边退开。"

translate schinese_rewrite Trunk_Drunk_Dialogue_9d1d24a0:

    # e "I'm not giving you another beer until you pay me back."
    e "在你还钱之前，我不会再给你啤酒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_83b2fad6:

    # drunk_patron "What? But... but... I'm your friend! Friends don't... hic... don't do that to each other!"
    drunk_patron "什么？可……可我是你的朋友！朋友不该……嗝……不该这样对彼此！"

translate schinese_rewrite Trunk_Drunk_Dialogue_bc4ed519:

    # e "The barkeep won't be happy if you don't pay up, he certainly would've been happier to free up the table for someone else."
    e "你不付钱，酒保可不会高兴；要是把这张桌子腾出来给别人，他肯定更高兴。"

translate schinese_rewrite Trunk_Drunk_Dialogue_01471800:

    # drunk_patron "W-what? Cane won't do that to me! I'm... I'm... hic... I'm his best customer!"
    drunk_patron "凯恩不会这样对我 我是..."

translate schinese_rewrite Trunk_Drunk_Dialogue_9c5effcf:

    # "He looks around the tavern, his eyes wide with panic."
    "他环顾酒馆，惊慌地睁大了双眼。"

translate schinese_rewrite Trunk_Drunk_Dialogue_14b72157:

    # drunk_patron "...fine. I'll pay you back. Just... just don't tell the barkeep, okay?"
    drunk_patron "……好吧。我会还钱的。就……就别告诉酒保，好吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_5172cf7f:

    # "You stare at him, waiting for him to make good on his promise."
    "你盯着他，等他兑现承诺。"

translate schinese_rewrite Trunk_Drunk_Dialogue_97b69af5:

    # "He fumbles in his pockets and pulls out a few coins, handing them to you."
    "他手忙脚乱地摸索口袋，掏出几枚硬币递给你。"

translate schinese_rewrite Trunk_Drunk_Dialogue_29c8eb6b:

    # drunk_patron "Here. Take it, server. A-and a tip for your t-trouble."
    drunk_patron "给。拿去，服务员。还、还有给你的辛、辛苦费。"

translate schinese_rewrite Trunk_Drunk_Dialogue_76110181:

    # "You take the 50 coins, nodding at him as you pocket the money."
    "你拿走50枚硬币，朝他点点头，把钱收进了口袋。"

translate schinese_rewrite Trunk_Drunk_Dialogue_f6d77b4a_1:

    # e "Thank you. Enjoy your drink."
    e "谢谢。慢用。"

translate schinese_rewrite Trunk_Drunk_Dialogue_82306952:

    # "Grumbles and complaints can be heard as you walk away from the table, the drunkard's voice quickly fading into the background."
    "你离开桌边时，身后传来阵阵嘟囔和抱怨，醉汉的声音很快消失在背景中。"

translate schinese_rewrite Trunk_Drunk_Dialogue_55097391:

    # "You look at the drunkard, shaking your head."
    "你看着醉汉，摇了摇头。"

translate schinese_rewrite Trunk_Drunk_Dialogue_f2c28ac1:

    # e "I'm sorry, but I don't have any beer on me right now."
    e "抱歉，但我现在身上没有啤酒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_b9f13fd2:

    # drunk_patron "No beer? Then what are you doing here? You should be... should be... hic... serving me!"
    drunk_patron "没有啤酒？那你来这里干什么？你应该……应该……嗝……给我上酒！"

translate schinese_rewrite Trunk_Drunk_Dialogue_97a91932:

    # "The drunkard slams the bottles on the table, spilling some of the beer on the table."
    "醉汉把瓶子重重地砸在桌上，啤酒洒出了一些。"

translate schinese_rewrite Trunk_Drunk_Dialogue_5f6e7928:

    # "You approach the drunk patron, who is slumped over the wooden table, his head resting on his arms."
    "你走近那个醉酒的客人，他趴在木桌上，头枕着双臂。"

translate schinese_rewrite Trunk_Drunk_Dialogue_5e1ad99e:

    # drunk_patron "Mhmm... more beer..."
    drunk_patron "嗯……再来点啤酒……"

translate schinese_rewrite Trunk_Drunk_Dialogue_dd59cfb4:

    # "The drunkard is now snoring loudly, his head resting on the table."
    "醉汉现在正呼呼大睡，脑袋枕在桌面上。"

translate schinese_rewrite Trunk_Drunk_Dialogue_8bd84e38:

    # drunk_patron "Hic... beer... whatever you've got... give me more of 'em."
    drunk_patron "嗝……啤酒……你有什么就给什么……再给我来点。"

translate schinese_rewrite Trunk_Drunk_Dialogue_67e5f2a4:

    # "The drunkard mumbles incoherently."
    "醉汉含混不清地喃喃自语。"

translate schinese_rewrite Trunk_Drunk_Dialogue_768044fb:

    # drunk_patron "More..."
    drunk_patron "再来……"

translate schinese_rewrite Trunk_Drunk_Dialogue_c831404a:

    # "You walk up to the drunkard's table, the smell of alcohol hitting you like a wall."
    "你走到醉汉的桌旁，酒精的气味像一堵墙般迎面撞来。"

translate schinese_rewrite Trunk_Drunk_Dialogue_8d116623:

    # "He glances up. You can see the feeble attempts he has made by the furrowed eye brows he's making."
    "他抬眼瞥了你一下。你从他紧皱的眉头看出，他正费力地试图打起精神。"

translate schinese_rewrite Trunk_Drunk_Dialogue_fc72e987:

    # drunk_patron "I saw you before, you are the one who served me the beer! Mind if I have another one?"
    drunk_patron "我见过你，你就是给我上啤酒的那个人！再来一杯行吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_8972d80c:

    # e "Sorry, but I am not working now."
    e "抱歉，但我现在没在工作。"

translate schinese_rewrite Trunk_Drunk_Dialogue_7c9e01b8:

    # drunk_patron "You're not working? Then why are you here? You should be... should be... hic... serving me!"
    drunk_patron "你没在工作？那你来这里干什么？你应该……应该……嗝……给我上酒！"

translate schinese_rewrite Trunk_Drunk_Dialogue_0610ef28:

    # drunk_patron "Don't talk to me until you bring me another beer! I... I'll pay you."
    drunk_patron "在你把另一杯啤酒拿来之前别跟我说话！我……我会付钱的。"

translate schinese_rewrite Trunk_Drunk_Dialogue_b356f3a3:

    # "The drunkard drools on the table, his eyes half-closed."
    "醉汉流着口水趴在桌上，双眼半睁半闭。"

translate schinese_rewrite Trunk_Drunk_Dialogue_f37b9066:

    # drunk_patron "W-with tips..."
    drunk_patron "还、还有小费……"

translate schinese_rewrite Trunk_Drunk_Dialogue_e465c2bb:

    # e "Okay, I'm off duty so I will buy from Cane directly, but you have to pay for my cut as well."
    e "好吧,我下班了 所以我会直接从凯恩那里买回来 但你也要为我的那份还钱。"

translate schinese_rewrite Trunk_Drunk_Dialogue_3a3b1abe:

    # drunk_patron "For what?"
    drunk_patron "为什么？"

translate schinese_rewrite Trunk_Drunk_Dialogue_c93d9fe4:

    # e "For the service, of course."
    e "当然是服务费。"

translate schinese_rewrite Trunk_Drunk_Dialogue_741cf875:

    # drunk_patron "...fine. Just... just give me the beer, server."
    drunk_patron "……好吧。把啤酒给我，服务员。"

translate schinese_rewrite Trunk_Drunk_Dialogue_df3ce9ba_1:

    # "You shake your head as you pull back from the table."
    "你摇摇头，从桌边退开。"

translate schinese_rewrite Trunk_Drunk_Dialogue_c8434e2a:

    # e "I told you, I'm not working now, you'll have to wait for the barkeep to serve you."
    e "我说了，我现在没在工作；你得等酒保给你上酒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_a1f2411d:

    # "You watch as he grumbles under his breath, his eyes narrowing as he watches you walk away."
    "你看着他低声嘟囔，目光变得阴沉，盯着你离开。"

translate schinese_rewrite Trunk_Drunk_Dialogue_4b132e38:

    # drunk_patron "I'm fine! I'm fine! I can drink more! I can drink more than anyone!"
    drunk_patron "我没事！我没事！我还能喝！我比谁都能喝！"

translate schinese_rewrite Trunk_Drunk_Dialogue_58db20ca:

    # e "You reminded me of a friend of mine. He's a good friend, but he's a bit of a handful when he's drunk."
    e "你让我想起了我的一个朋友。他是个好朋友，但喝醉时有点难对付。"

translate schinese_rewrite Trunk_Drunk_Dialogue_691be03e:

    # drunk_patron "A good friend... no one's a good friend when they're drunk! They're all... all... hic... messed up."
    drunk_patron "好朋友……没人喝醉时还是好朋友！他们全都……全都……嗝……乱套了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_aeffa275:

    # e "You're right. I'll leave you to your drink then."
    e "你说得对。那我就不打扰你喝酒了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_3193f932:

    # drunk_patron "You've ever heard of the... the... the... the tale of the dewdrop beer?"
    drunk_patron "你听说过……露珠啤酒……的……的……的传说吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_86ac6cf1:

    # e "I can't say I have."
    e "我不能说听过。"

translate schinese_rewrite Trunk_Drunk_Dialogue_03798771:

    # drunk_patron "It's... it's... it's said that... that... hic... that the beer was made from the tears of a... a... scary werewolf!"
    drunk_patron "据说……据说……据说那啤酒是用……一头……一头……嗝……可怕的狼人的眼泪酿成的！"

translate schinese_rewrite Trunk_Drunk_Dialogue_de849014:

    # drunk_patron "And... every day... on the earliest of mornings... you can find him weeping... weeping... hic... weeping for his lost love..."
    drunk_patron "而且……每天……每天清晨最早的时候……你都能找到他在哭泣……为他失去的爱人……哭泣……嗝……哭泣……"

translate schinese_rewrite Trunk_Drunk_Dialogue_2b6e3132:

    # e "That's... quite a story. Did you make it up just now?"
    e "这……倒是个挺有意思的故事。你刚才才编出来的吧？"

translate schinese_rewrite Trunk_Drunk_Dialogue_2f3cb20d:

    # drunk_patron "No! No... I... I heard it from... somewhere... else... hic... I think."
    drunk_patron "不！不是……我……我从……从别的地方听来的……嗝……我想。"

translate schinese_rewrite Trunk_Drunk_Dialogue_c27107cc:

    # drunk_patron "That damn bard... he's... he's... hic... he's playing that song again!"
    drunk_patron "那个该死的吟游诗人……他……他……嗝……他又在唱那首歌了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_0beb882a:

    # "The drunkard points a finger upwards to the source of the music, his eyes squinting in annoyance."
    "醉汉朝楼上音乐传来的方向竖起一根手指，恼怒地眯起眼睛。"

translate schinese_rewrite Trunk_Drunk_Dialogue_60e8d191:

    # e "Which one?"
    e "哪一首？"

translate schinese_rewrite Trunk_Drunk_Dialogue_d8cc7509:

    # drunk_patron "...the one about the... the... the... bastard or something."
    drunk_patron "……就是那首讲……讲……讲……私生子什么的歌。"

translate schinese_rewrite Trunk_Drunk_Dialogue_65871686:

    # drunk_patron "You know what... now that I think of it, I could've been... been... hic... a bastard too."
    drunk_patron "你知道吗……现在想想，我也可能是……是……嗝……个私生子。"

translate schinese_rewrite Trunk_Drunk_Dialogue_7950ea65:

    # e "Oh, really?"
    e "哦，真的吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_4cc03fef:

    # "He nods, his head bobbing up and down as he does so."
    "他点点头，脑袋随之上下晃动。"

translate schinese_rewrite Trunk_Drunk_Dialogue_d0fe7e06:

    # drunk_patron "Yeah... yeah... I could've been a bastard and not even know it! Can you... can you imagine that?"
    drunk_patron "是啊……是啊……我可能是个私生子，甚至自己都不知道！你……你能想象吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_57f74ad6:

    # e "I can't imagine that, no."
    e "我想象不出来，不行。"

translate schinese_rewrite Trunk_Drunk_Dialogue_feef455c:

    # "The drunkard buries his head in his arms, his voice muffled as he sings."
    "醉汉把头埋进臂弯里，声音闷闷地唱了起来。"

translate schinese_rewrite Trunk_Drunk_Dialogue_7e225234:

    # drunk_patron "{i}Kins turned foes,... hic... and the... king's... turned fool's.{/i}"
    drunk_patron "{i}亲族反目成仇……嗝……而国王……变成了愚王。{/i}"

translate schinese_rewrite Trunk_Drunk_Dialogue_69ed2fb6:

    # "He raises the empty bottle to his lips, pretending to take a sip."
    "他把空瓶举到唇边，假装抿了一口。"

translate schinese_rewrite Trunk_Drunk_Dialogue_fa83ab8a:

    # drunk_patron "{i}Benea- thic... the palace floor, laid unto... hic the bereaved bastard boy!{/i}"
    drunk_patron "{i}在宫殿地板……嗝……之下，安葬了……嗝……那个悲苦的私生子！{/i}"

translate schinese_rewrite Trunk_Drunk_Dialogue_63253c51:

    # "You listen as he follows the tune from the bard above, his voice cracking as he tries to hit the high notes."
    "你听着他跟随楼上吟游诗人的曲调哼唱；为了唱上高音，他的声音都劈了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_32e16567:

    # drunk_patron "This place used to be... used to be... hic... better back in my day. The beer was... was... was much stronger than this piss in my mouth!"
    drunk_patron "这个地方以前……以前……嗝……比现在好。那时的啤酒……那时的啤酒……比我嘴里的这泡尿……这泡尿烈多了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_d2cdd83c:

    # e "What changed?"
    e "什么变了？"

translate schinese_rewrite Trunk_Drunk_Dialogue_19cbf074:

    # drunk_patron "I don't know! I don't know! But I'm... I'm... hic... I'm not happy about it!"
    drunk_patron "我不知道！我不知道！但我……我……嗝……我对此很不高兴！"

translate schinese_rewrite Trunk_Drunk_Dialogue_40ee61b1:

    # e "About what?"
    e "对什么？"

translate schinese_rewrite Trunk_Drunk_Dialogue_8ea64c27:

    # drunk_patron "About... about... hic... the change! Now, it's all... uh... bad!"
    drunk_patron "对……对……嗝……对变化！现在一切都……呃……糟透了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_ca274bdd:

    # "You shake your head as you listen to him ramble on for a good minutes before slurring on his words again."
    "你摇摇头，听他絮絮叨叨了好几分钟，直到他又开始含糊其辞。"

translate schinese_rewrite Trunk_Drunk_Dialogue_d1766d39:

    # e "Say... you seem to be drinking a lot here, do you have a home to go back to?"
    e "话说……你似乎喝了很多酒，你有家可回吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_3a2e3138:

    # drunk_patron "Home? Yeah I've got one, right in my... my... hic... my crotch!"
    drunk_patron "家？有啊，就在我的……我的……嗝……我的胯下！"

translate schinese_rewrite Trunk_Drunk_Dialogue_82c8437d:

    # e "That's not a great home to live in, you know."
    e "你知道，那可不是个适合居住的好地方。"

translate schinese_rewrite Trunk_Drunk_Dialogue_29d79099:

    # drunk_patron "What? You... you... you don't like my home? It's... it's... it's cozy! I'm sure you'll love it, friend."
    drunk_patron "什么？你……你……你不喜欢我的家？它……它……它很舒服！我敢保证你会喜欢的，朋友。"

translate schinese_rewrite Trunk_Drunk_Dialogue_ebec1fab:

    # "He winks at you, hands gesturing to his bulging crotch as he does so."
    "他朝你眨眨眼，手势指向自己鼓起的胯部。"

translate schinese_rewrite Trunk_Drunk_Dialogue_9534290d:

    # e "I think I'll pass on that offer."
    e "我想还是算了吧。"

translate schinese_rewrite Trunk_Drunk_Dialogue_306bae6b:

    # drunk_patron "Suit yourself! I have... I have... hic... plenty of friends who'd love to visit my home!"
    drunk_patron "随你的便！我……我……嗝……我有的是想来我家做客的朋友！"

translate schinese_rewrite Trunk_Drunk_Dialogue_cd2cb027:

    # drunk_patron "You... you... you're missing out, friend! You're missing out on the best... the best... hic... the best time of your life!"
    drunk_patron "你……你……你可亏大了，朋友！你错过了……最棒的……最棒的……嗝……人生乐趣！"

translate schinese_rewrite Trunk_Drunk_Dialogue_c3d1a9d9:

    # e "I'm sure I am."
    e "我相信是这样。"

translate schinese_rewrite Trunk_Drunk_Dialogue_87669b53:

    # "You shake your head as you walk away from the table, the drunkard's laughter echoing in your ears."
    "你摇着头离开桌边，醉汉的笑声在你耳边回荡。"

translate schinese_rewrite Trunk_Drunk_Dialogue_83a1bf2a:

    # drunk_patron "Just one more... just one more... hic... and I'm done, gotta go home and sleep it off..."
    drunk_patron "再来一杯……就一杯……嗝……我就喝完了，得回家睡一觉醒醒酒……"

translate schinese_rewrite Trunk_Drunk_Dialogue_b2eb6c2c:

    # drunk_patron "I swear... I swear... I won't drink again... until tomorrow! Haha!"
    drunk_patron "我发誓……我发誓……我明天之前绝不再喝！哈哈！"

translate schinese_rewrite Trunk_Drunk_Dialogue_40e51f03:

    # drunk_patron "Bring me more beer... hic... serv-"
    drunk_patron "再给我来点啤酒……嗝……服——"

translate schinese_rewrite Trunk_Drunk_Dialogue_3512e629:

    # "He stops mid-sentence, his eyes widening as he sees you approach the table."
    "他话说到一半停了下来，看到你走近桌边时，双眼睁得老大。"

translate schinese_rewrite Trunk_Drunk_Dialogue_e819489c:

    # drunk_patron "You know what... I... I... I don't want any more beer... I... I... I'm good."
    drunk_patron "你知道吗……我……我……我不想再喝啤酒了……我……我……我挺好的。"

translate schinese_rewrite Trunk_Drunk_Dialogue_f620cba4:

    # e "Are you sure? You seemed pretty insistent on having more beer earlier."
    e "你确定？刚才你还一个劲儿地要更多啤酒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_56adbbca:

    # "The drunkard shakes his head, his hand waving you away as he does so."
    "醉汉摇了摇头，同时挥手示意你走开。"

translate schinese_rewrite Trunk_Drunk_Dialogue_65fc6bba:

    # drunk_patron "I... I... I was? Oh... I... I don't remember that... I... I... hic... I must've been drunk."
    drunk_patron "我……我……我刚才是这样吗？哦……我……我不记得了……我……我……嗝……我肯定喝醉了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_0d2b2f23:

    # drunk_patron "Please don't kick me out of the tavern, server! I... I... I promise I won't cause any more trouble!"
    drunk_patron "服务员，别把我赶出酒馆！我……我……我保证不会再惹麻烦了！"

translate schinese_rewrite Trunk_Drunk_Dialogue_0ea97f65:

    # drunk_patron "Server, where is your apron... and your tray? You're... you're... hic... you're not working!"
    drunk_patron "服务员，你的围裙……还有托盘呢？你……你……嗝……你没在工作！"

translate schinese_rewrite Trunk_Drunk_Dialogue_ba5ca6db:

    # e "I told you I'm off duty, you'll have to wait for the barkeep to serve you."
    e "我说过我已经下班了，你得等酒保给你上酒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_9e7e09bb:

    # drunk_patron "Barkeep? I don't... I don't... hic... I don't want him to serve me! I want you to serve me!"
    drunk_patron "酒保？我不……我不……嗝……我不想让他给我上酒！我要你给我上酒！"

translate schinese_rewrite Trunk_Drunk_Dialogue_f3bbc621:

    # drunk_patron "You... I've seen you under that apron before, you're... you're... hic... you're good at serving!"
    drunk_patron "你……我以前见过你穿着那条围裙，你……你……嗝……你很会招待客人！"

translate schinese_rewrite Trunk_Drunk_Dialogue_261ce842:

    # e "Uhm... thanks, I guess?"
    e "呃……谢了吧？"

translate schinese_rewrite Trunk_Drunk_Dialogue_0cede7d1:

    # drunk_patron "Yeah! Yeah! You should put that mouth to good use and serve me under the table too! Haha!"
    drunk_patron "对！对！你该好好利用那张嘴，钻到桌子底下也给我上酒！哈哈！"

translate schinese_rewrite Trunk_Drunk_Dialogue_c5de9ca7:

    # "The drunkard points on the ground, his grin wide as he winks at you."
    "醉汉指了指地面，咧嘴朝你眨了眨眼。"

translate schinese_rewrite Trunk_Drunk_Dialogue_30014c58:

    # drunk_patron "Bring me more be-..."
    drunk_patron "再给我来点啤——……"

translate schinese_rewrite Trunk_Drunk_Dialogue_952633ed:

    # e "What were you saying?"
    e "你刚才说什么？"

translate schinese_rewrite Trunk_Drunk_Dialogue_3d2f1d8d:

    # drunk_patron "I... I... I'm broke! I... I... I can't pay for the beer! hic..."
    drunk_patron "我……我……我没钱了！我……我……我付不起啤酒钱！嗝……"

translate schinese_rewrite Trunk_Drunk_Dialogue_b197f02a:

    # drunk_patron "I spent all my money on... on... hic... on the beer! I... I... I don't have any left!"
    drunk_patron "我把所有钱都花在……花在……嗝……花在啤酒上了！我……我……一枚都不剩！"

translate schinese_rewrite Trunk_Drunk_Dialogue_10c668b5:

    # e "You are still drunk, aren't you?"
    e "你还醉着，对吧？"

translate schinese_rewrite Trunk_Drunk_Dialogue_081c527c:

    # drunk_patron "I'm not! I'm not... hic... I'm just... just... a little... tipsy!"
    drunk_patron "我没有！我没有……嗝……我只是……只是……有一点……微醺！"

translate schinese_rewrite Trunk_Drunk_Dialogue_3a6c8246:

    # "He shoves his hand in his pocket, trying to look for something until he stares at you with a realisation."
    "他把手伸进口袋，摸索着找东西，直到看着你时才恍然大悟。"

translate schinese_rewrite Trunk_Drunk_Dialogue_8f3da3c2:

    # drunk_patron "Can you give... give me back the amulet? I... I... I need it back to earn more coins!"
    drunk_patron "你能……能把护符还给我吗？我……我……我得拿回它来赚更多硬币！"

translate schinese_rewrite Trunk_Drunk_Dialogue_58490ad2:

    # e "You gave it to me, remember?"
    e "你把它送给我了，还记得吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_f2945028:

    # drunk_patron "I... I... I did? Oh... I did, didn't I?"
    drunk_patron "我……我……我送过？哦……我送过，对吧？"

translate schinese_rewrite Trunk_Drunk_Dialogue_e0b39eb8:

    # "The drunkard hides his head back in his crossed arms, his voice muffled the loud scream that would have deafened you."
    "醉汉又把头埋进交叠的双臂中，闷声发出一声本该震聋你的大叫。"

translate schinese_rewrite Trunk_Drunk_Dialogue_87e35044:

    # e "You should probably slow down, you're going to pass out soon."
    e "你最好放慢点，你很快就要醉倒了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_d63c6c56:

    # drunk_patron "You better not... hic... you better not tell me what to do! I can drink more than anyone in this tavern!"
    drunk_patron "你最好别……嗝……别来教训我该做什么！我能比这酒馆里任何人喝得都多！"

translate schinese_rewrite Trunk_Drunk_Dialogue_20ad44cd:

    # "You watch as he takes another swig of his beer, taking in a big gulp after another."
    "你看着他又喝了一口啤酒，一口接一口地大口吞咽。"

translate schinese_rewrite Trunk_Drunk_Dialogue_b0d0f6e7:

    # drunk_patron "Uhh... server... I... I... I need another beer... I... I... I'll pay you back!"
    drunk_patron "呃……服务员……我……我……我还要一杯啤酒……我……我会还钱的！"

translate schinese_rewrite Trunk_Drunk_Dialogue_582bbd89:

    # e "Again, I'm not working now."
    e "我再说一次，我现在没在工作。"

translate schinese_rewrite Trunk_Drunk_Dialogue_95f37def:

    # drunk_patron "Not working? But... but... you served me before! You... you... hic... you have to serve me again!"
    drunk_patron "没在工作？可是……可是……你之前给我上过酒！你……你……嗝……你必须再给我上酒！"

translate schinese_rewrite Trunk_Drunk_Dialogue_e465c2bb_1:

    # e "Okay, I'm off duty so I will buy from Cane directly, but you have to pay for my cut as well."
    e "好吧,我下班了 所以我会直接从凯恩那里买回来 但你也要为我的那份还钱。"

translate schinese_rewrite Trunk_Drunk_Dialogue_95831e41:

    # drunk_patron "Uhm... okay."
    drunk_patron "呃……好吧。"

translate schinese_rewrite Trunk_Drunk_Dialogue_df3ce9ba_2:

    # "You shake your head as you pull back from the table."
    "你摇摇头，从桌边退开。"

translate schinese_rewrite Trunk_Drunk_Dialogue_c8434e2a_1:

    # e "I told you, I'm not working now, you'll have to wait for the barkeep to serve you."
    e "我说了，我现在没在工作；你得等酒保给你上酒。"

translate schinese_rewrite Trunk_Drunk_Dialogue_a1f2411d_1:

    # "You watch as he grumbles under his breath, his eyes narrowing as he watches you walk away."
    "你看着他低声嘟囔，目光变得阴沉，盯着你离开。"

translate schinese_rewrite Trunk_Drunk_Dialogue_cf908d7d:

    # drunk_patron "Hic! You're a fine lookin' one, a-a-aren't you?"
    drunk_patron "嗝！你长得真好看，不、不是吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_07c72c1b:

    # "The drunkard slurs his words as he tries to focus on you. His breath reeks of alcohol."
    "醉汉一边努力看清你，一边含糊地说着话。他的呼吸里满是酒气。"

translate schinese_rewrite Trunk_Drunk_Dialogue_9d54bd1d:

    # drunk_patron "Y-you ever seen a dragon... hic... with a beard?"
    drunk_patron "你见过……嗝……长胡子的龙吗？"

translate schinese_rewrite Trunk_Drunk_Dialogue_98578f9c:

    # drunk_patron "Swear I saw one just now! It was... was... right after my fifth ale. Or maybe it was the sixth..."
    drunk_patron "我发誓我刚才看见了一条！就在……就在我喝第五杯麦芽酒之后。或者也可能是第六杯……"

translate schinese_rewrite Trunk_Drunk_Dialogue_d8947b50:

    # e "Were you talking about me...?"
    e "你是在说我吗……？"

translate schinese_rewrite Trunk_Drunk_Dialogue_a4b49874:

    # drunk_patron "Huh? Oh, you're not a dragon... hic... are you?"
    drunk_patron "啊？哦，你不是龙……嗝……对吧？"

translate schinese_rewrite Trunk_Drunk_Dialogue_7e8f23d2:

    # e "Are you sure it's safe drinking all those beer, you look like you're on the verge of passing out."
    e "你确定喝那么多啤酒没事吗？你看起来都快醉倒了。"

translate schinese_rewrite Trunk_Drunk_Dialogue_fa198723:

    # drunk_patron "You... you're a good listener, you know that? Not like the others... they... they don't understand me."
    drunk_patron "你……你真是个很好的听众，你知道吗？不像其他人……他们……他们不理解我。"

translate schinese_rewrite Trunk_Drunk_Dialogue_9c53d5a9:

    # e "I'm here to listen, what's on your mind?"
    e "我在听，你有什么心事？"

translate schinese_rewrite Trunk_Drunk_Dialogue_38abbae8:

    # "The drunkard looks at you with bleary eyes, his gaze unfocused."
    "醉汉用朦胧的双眼看着你，目光没有焦点。"

translate schinese_rewrite Trunk_Drunk_Dialogue_a52941f6:

    # drunk_patron "You know... you know... I used to be... a-a-a great warrior... I fought... fought... hic... the goats..."
    drunk_patron "你知道……你知道……我以前是个……很、很、很伟大的战士……我战斗过……战斗过……嗝……和羊人族……"

translate schinese_rewrite Trunk_Drunk_Dialogue_3035950d:

    # "His voice trails off as he buries his face in his arms."
    "他的声音渐渐低了下去，把脸埋进臂弯。"

translate schinese_rewrite Trunk_Drunk_Dialogue_02617ecd:

    # drunk_patron "W-whatever... I don't care... give me another beer..."
    drunk_patron "随便吧……我不在乎……再给我一杯啤酒……"

translate schinese_rewrite Trunk_Eater_Dialogue_3ba4c95e:

